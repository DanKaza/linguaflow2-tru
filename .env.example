[TEMPLATE]
# ── Mode Prototipe ──
# Aplikasi berjalan TANPA backend/auth sendiri (data demo di src/lib/demo-data.ts).
# Fitur AI (Sensei, TTS, STT) memakai API LinguaFlow (lihat api.md).

# API LinguaFlow — base URL (default sudah production, tak perlu diisi)
# NEXT_PUBLIC_LINGUAFLOW_API_URL=https://lg.tixrouter.my.id/api/v1

# Suara Live (WS /sensei/live) butuh token ADMIN API.
# Kredensial TIDAK BOLEH pakai prefix NEXT_PUBLIC_ — hanya dipakai route
# broker /api/sensei/live-token di server (username/password admin dashboard).
LINGUAFLOW_ADMIN_USERNAME=
LINGUAFLOW_ADMIN_PASSWORD=

# Supabase — belum dipakai di mode prototipe (rencana integrasi berikutnya)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
