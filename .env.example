[TEMPLATE]
# ── Mode Prototipe ──
# Aplikasi berjalan TANPA backend/auth sendiri (data demo di src/lib/demo-data.ts).
# Fitur AI (Sensei, TTS, STT) memakai API LinguaFlow (lihat api.md).

# API LinguaFlow — base URL (default sudah production)
# NEXT_PUBLIC_LINGUAFLOW_API_URL=https://lg.tixrouter.my.id/api/v1

# Suara Live (AI Sensei) — kunci API Gemini untuk WebSocket Live.
# Wajib untuk fitur Suara Live; TANPA prefix NEXT_PUBLIC_ (dibaca route
# broker server /api/sensei/live-token, tidak pernah masuk bundle browser).
GEMINI_API_KEY=

# Supabase — belum dipakai di mode prototipe (rencana integrasi berikutnya)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
